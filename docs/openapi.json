    "/api/v1/imports": {
      "post": {
        "description": "Mendukung tipe items, opening_balance, suppliers, dan locations. Default dry_run=true untuk memverifikasi data dan menampilkan rekonsiliasi.",
        "operationId": "ImportController_uploadImport",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "file": {
                    "type": "string",
                    "format": "binary"
                  },
                  "import_type": {
                    "type": "string",
                    "enum": [
                      "items",
                      "opening_balance",
                      "suppliers",
                      "locations"
                    ]
                  },
                  "dry_run": {
                    "type": "boolean",
                    "default": true
                  }
                },
                "required": [
                  "file",
                  "import_type"
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Job impor berhasil dibuat dan divalidasi",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ImportJobResponseDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Unggah berkas Excel untuk validasi (dry-run) atau eksekusi langsung",
        "tags": [
          "Imports"
        ]
      }
    },
    "/api/v1/imports/{id}": {
      "get": {
        "operationId": "ImportController_getImportJob",
        "parameters": [],
