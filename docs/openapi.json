  "info": {
    "title": "Depo Farmasi API",
    "description": "API Pengadaan dan Pengelolaan Barang Depo Farmasi (Obat dan BMHP)",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "AuthResponseDto": {
        "type": "object",
        "properties": {
          "access_token": {
            "type": "string",
            "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
          },
          "token_type": {
            "type": "string",
            "example": "Bearer"
          },
          "expires_in": {
            "type": "number",
            "example": 900
          },
          "must_change_password": {
            "type": "boolean",
            "example": false
          }
        },
        "required": [
          "access_token",
          "token_type",
          "expires_in",
          "must_change_password"
        ]
      },
      "StockBalanceItemDto": {
        "type": "object",
        "properties": {
          "item_id": {
            "type": "string",
            "example": "01934335-508b-7c30-97c7-578841443653"
          },
          "item_code": {
            "type": "string",
            "example": "AA0096"
          },
          "item_name": {
            "type": "string",
            "example": "Paracetamol"
          },
          "item_type": {
            "type": "string",
            "example": "obat"
          },
          "location_id": {
            "type": "string",
            "example": "01934335-508b-7c30-97c7-578841443654"
          },
          "location_name": {
            "type": "string",
            "example": "Gudang Farmasi Utama"
          },
          "quantity": {
            "type": "string",
            "example": "150.000"
          },
          "safety_stock": {
            "type": "string",
            "example": "50.000"
          },
          "min_stock": {
            "type": "string",
            "example": "100.000"
          },
          "status": {
            "type": "string",
            "enum": [
              "cito",
              "menipis_cito",
              "menipis",
              "aman"
            ],
            "example": "aman"
          },
          "total_valuation": {
            "type": "string",
            "example": "750000.0000"
          }
        },
        "required": [
          "item_id",
          "item_code",
          "item_name",
          "item_type",
          "location_id",
          "location_name",
          "quantity",
          "safety_stock",
          "min_stock",
          "status",
          "total_valuation"
        ]
      },
      "BatchStockDto": {
        "type": "object",
        "properties": {
          "batch_id": {
            "type": "string",
            "example": "01934335-508b-7c30-97c7-578841443655"
          },
          "batch_number": {
            "type": "string",
            "example": "LEGACY-1"
          },
          "expiry_date": {
            "type": "string",
            "example": "2027-12-31"
          },
          "unit_cost": {
            "type": "string",
            "example": "5000.0000"
          },
          "quantity": {
            "type": "string",
            "example": "100.000"
          },
          "is_legacy": {
            "type": "boolean",
            "example": true
          },
          "valuation": {
            "type": "string",
            "example": "500000.0000"
          }
        },
        "required": [
          "batch_id",
          "batch_number",
          "unit_cost",
          "quantity",
          "is_legacy",
          "valuation"
        ]
      },
      "LocationStockDetailDto": {
        "type": "object",
        "properties": {
          "location_id": {
            "type": "string",
            "example": "01934335-508b-7c30-97c7-578841443654"
          },
          "location_code": {
            "type": "string",
            "example": "GUDANG-01"
          },
          "location_name": {
            "type": "string",
            "example": "Gudang Farmasi Utama"
          },
          "quantity": {
            "type": "string",
            "example": "150.000"
          },
          "batches": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BatchStockDto"
            }
          }
        },
        "required": [
          "location_id",
          "location_code",
          "location_name",
          "quantity",
          "batches"
        ]
      },
      "ItemStockDetailDto": {
        "type": "object",
        "properties": {
          "item_id": {
            "type": "string",
            "example": "01934335-508b-7c30-97c7-578841443653"
          },
          "item_code": {
            "type": "string",
            "example": "AA0096"
          },
          "item_name": {
            "type": "string",
            "example": "Paracetamol"
          },
          "total_quantity": {
            "type": "string",
            "example": "150.000"
          },
          "total_valuation": {
            "type": "string",
            "example": "750000.0000"
          },
          "locations": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/LocationStockDetailDto"
            }
          }
        },
        "required": [
          "item_id",
          "item_code",
          "item_name",
          "total_quantity",
          "total_valuation",
